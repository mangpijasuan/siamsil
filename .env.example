SIAMSIL_DATA_DIR=./backend/data
SIAMSIL_LANGUAGE_DB=./data/processed/language/siamsil_language.sqlite
SIAMSIL_ENVIRONMENT=development
SIAMSIL_DATABASE_URL=postgresql+psycopg://siamsil:siamsil-local-only@127.0.0.1:55433/siamsil
SIAMSIL_DATABASE_REQUIRED=false
SIAMSIL_POSTGRES_PORT=55433
SIAMSIL_POSTGRES_PASSWORD=siamsil-local-only
# Configure these with your OpenID Connect provider before enabling sign-in.
SIAMSIL_OIDC_ENABLED=false
# SIAMSIL_OIDC_ISSUER=https://identity.example.com/
# SIAMSIL_OIDC_AUDIENCE=https://api.siamsil.com
# SIAMSIL_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# JSON list of trusted provider subject IDs allowed to bootstrap administrators.
SIAMSIL_BOOTSTRAP_ADMIN_SUBJECTS=[]

# Requests per client per minute on translate, search, and assistant routes (0 disables).
# Behind a proxy, also set FORWARDED_ALLOW_IPS for uvicorn so limits apply per real client.
SIAMSIL_RATE_LIMIT_PER_MINUTE=0
# FORWARDED_ALLOW_IPS=*
# System answering /api/v1/translate; changing it is how a model is promoted or rolled back.
SIAMSIL_TRANSLATION_SYSTEM=retrieval
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Production (set these in Vercel dashboard, not committed to git)
# SIAMSIL_API_URL=https://api.siamsil.com
