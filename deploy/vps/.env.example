# Copy to .env on the server (`cp .env.example .env`, then `chmod 600 .env`) and fill in.
# Never commit .env. Never put the UPLOAD token here: only the read-only one.
API_DOMAIN=api.siamsil.org
POSTGRES_PASSWORD=change-me-to-a-long-random-password
SIAMSIL_CORS_ORIGINS=["https://siamsil.org","https://www.siamsil.org"]
SIAMSIL_DATA_BUNDLE_S3_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
SIAMSIL_DATA_BUNDLE_S3_BUCKET=siamsil-data-bundle
SIAMSIL_DATA_BUNDLE_S3_ACCESS_KEY_ID=read-only-token-access-key-id
SIAMSIL_DATA_BUNDLE_S3_SECRET_ACCESS_KEY=read-only-token-secret
SIAMSIL_DATA_BUNDLE_SHA256=64-character-sha256-of-the-bundle
# Leave false: the parallel corpus is blocked in data/rights.json (this is also the default).
SIAMSIL_SERVE_PARALLEL_CORPUS=false
